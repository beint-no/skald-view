{
  "name": "@beint/skald-view",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test web/*.test.mjs",
    "test:browser": "playwright test",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "verify:corpus": "node scripts/verify-corpus.mjs",
    "package": "node scripts/package.mjs",
    "format:check": "prettier --check 'web/*.{mjs,html,css,json}' 'scripts/*.mjs' 'tests/browser/*.mjs' playwright.config.mjs package.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.9.10"
  }
}
